#pragma once

/** Optional local overrides — copy to secrets.h (gitignored) for bench/dev builds.
 *
 *  cp include/secrets.h.example include/secrets.h
 *  Edit secrets.h with your Wi-Fi and location. Never commit secrets.h.
 */
#define PLANE_RADAR_SECRETS_ACTIVE 1

namespace plane_radar_secrets {

inline constexpr bool kWifiSkipPortal = false;
inline constexpr char kWifiSsid[] = "your-wifi-ssid";
inline constexpr char kWifiPass[] = "your-wifi-password";

/** When true, overwrites NVS default location on boot (dev only). */
inline constexpr bool kOverrideDefaultLocation = false;
inline constexpr double kDefaultRadarLat = 52.3676;
inline constexpr double kDefaultRadarLon = 4.9041;

}  // namespace plane_radar_secrets
